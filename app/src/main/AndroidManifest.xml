<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The app is primarily a TV/TV-box experience driven by a D-pad, but it also
      runs well on phones and tablets. touchscreen is therefore not required, so
      the app can be installed on Android TV boxes and leanback devices.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Required to install an in-app downloaded update. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Lets the app start itself when the device boots, so a television turns on
      straight into Kurdish TV Live. Read by AutoStartReceiver, which honours the
      viewer's "Auto-resume on start" switch before launching anything.

      Note on Android 10+ background-activity-start restrictions: some firmwares
      block an activity launched straight from a boot broadcast. When that happens
      nothing breaks — the app simply opens on the next manual launch, straight
      into the last watched channel (the same setting drives both behaviours).
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Needed on Android 11+ so the updater can tell whether an update exists. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!--
          Start.io (StartApp) ad SDK.

          SPLASH_ENABLED=false disables the SDK's full-screen "return ad" on launch.
          The app has its own navigation and its own update flow, and a second,
          uncontrolled full-screen surface on the way in is not something this
          product wants; the initialiser also passes setReturnAdsEnabled(false).

          The remaining permissions the SDK needs (INTERNET, ACCESS_NETWORK_STATE,
          ACCESS_WIFI_STATE, RECEIVE_BOOT_COMPLETED, AD_ID and ACCESS_ADSERVICES_TOPICS)
          are declared by the SDK's own manifest and merged in, so they are
          deliberately not repeated here.
        -->
        <provider
            android:name="com.startapp.sdk.adsbase.StartAppInitProvider"
            tools:node="remove" />

        <meta-data
            android:name="com.startapp.sdk.SPLASH_ENABLED"
            android:value="false" />

        <!--
          The Privacy Sandbox Topics configuration the SDK expects on Android 13+.
          The element is ignored below API 31, hence the tools:targetApi annotation.
        -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/ad_services_config"
            tools:targetApi="s" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:banner="@drawable/ic_tv_banner"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <!--
              `stateHidden`, not the bare `adjustResize` this used to carry.

              The default soft-input state is `stateUnspecified`, which lets the
              system *restore* the IME visibility of the previous session: if the
              app was last used with the on-screen keyboard up — and on a TV box it
              is usually killed rather than exited, so "last used" is often exactly
              that — the keyboard was re-shown on the very first frame, over the
              channel grid, with the search field focused underneath it. That is
              the "search opens by itself" bug, and it happens before any of the
              app's own focus placement gets a chance to run.

              `stateHidden` says the IME must not be shown when the activity starts,
              whatever state it was in before. It applies only at launch: a viewer who
              deliberately navigates to the search field still gets the keyboard,
              because that is a fresh showSoftInput call from the focused field.

              `adjustResize` is kept — it is what makes the window shrink when the
              keyboard *is* open, so the results stay visible while typing.
            -->
            <!--
              Two filters, not one.

              LEANBACK_LAUNCHER is what puts the app on the Android TV home screen.
              It was missing, so the manifest below declared the leanback feature
              and the UI was built for a D-pad, but on an actual television the app
              could only be started from the app drawer of a launcher that happened
              to list non-TV activities — and on stock Android TV, which is the
              common case, there is no such list. The app was effectively
              unlaunchable on the device it is designed for.

              Both categories stay on the same filter so one install serves phones,
              tablets and televisions.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.software.leanback.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Starts the app when the device boots, so a TV that turns on goes straight
          to the last watched channel. `exported="false"`: the only broadcasts it
          answers are the system's own boot actions, and no other app can deliver
          them.

          QUICKBOOT_POWER_ON is the same event under the name several TV boxes and
          HTC-style firmwares send instead of BOOT_COMPLETED.
        -->
        <receiver
            android:name=".kurdishtv.boot.AutoStartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWER_ON" />
            </intent-filter>
        </receiver>

        <!--
          Exposes a downloaded update APK to the system package installer as a
          content:// URI. A file:// URI is rejected on Android 7+.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.aistudio.kurdishtv.live.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
